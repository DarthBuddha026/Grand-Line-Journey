# Accounts API address, only if it is NOT served from the same site as the game
# (e.g. the game on a static host, `npm start` running elsewhere). Leave empty otherwise.
# The API server then needs ALLOWED_ORIGIN=<the game's origin> in its environment.
VITE_API_URL=

# Public address of the hosted game (trailing slash), for social link previews.
VITE_SITE_URL=
