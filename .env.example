# Google sign-in + cloud saves (Firebase). Copy to .env.local and fill in from
# Firebase console → Project settings → Your apps → Web app → SDK config.
# Leave empty to ship without Google sign-in (players can still play as guests).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Public address of the hosted game (trailing slash), for social link previews.
VITE_SITE_URL=
